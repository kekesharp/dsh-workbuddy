# dsh-workbuddy — 分享用配置模板
#
# ⚠️ 这是给「别人」用的模板，不是本机在跑的那份（本机那份里含本机路径）。
#    发布前用这份覆盖包内的 cordis.patch.yml：
#        cp cordis.patch.yml.example cordis.patch.yml
#    或者直接把本文件重命名后发布。
#
# 本插件把 WorkBuddy / CodeBuddy 网关（workbuddy2api 系）接进 DSH：
#   1. DSH 启动时探测网关，未运行则按 launchScript 拉起（留空则只探测不拉起）；
#   2. 页面右下角提供图标，点开即内嵌官方 Web 面板（账号 / 积分 / 用量 / 任务）；
#   3. 通过 /workbuddy/* 暴露网关、账号、区域、模型状态。
#
# 前置条件：本插件**不打包网关**，需要你先自行安装并跑通 workbuddy2api。
# 面板地址形如 http://127.0.0.1:8788/ ，/health 返回 {"ok":true,...} 即算就绪。

- insert:
    - id: workbuddy
      name: 'dsh-workbuddy'
      config:
        # ── 网关地址 ──────────────────────────────────────────────
        # 面板 iframe 与 /health 探测都用它（写成 .../v1 也可以，插件会自动去掉）。
        gatewayUrl: http://127.0.0.1:8788

        # ── 自动拉起 ──────────────────────────────────────────────
        # 是否在 DSH 启动时拉起网关。true 但 launchScript 为空 → 只探测。
        autoStart: true
        # 网关启动脚本的绝对路径（支持 ~ 展开）。各人安装位置不同，必须显式配置。
        # macOS/Linux 一般是 <网关目录>/start-wb-proxy.sh，Windows 用 .bat。
        # 例：~/workbuddy2api-hub/wb-proxy/start-wb-proxy.sh
        launchScript: ''
        # 拉起时传入的端口，必须与 gatewayUrl 的端口一致。
        gatewayPort: 8788

        # ── 面板会话（可选）───────────────────────────────────────
        # 面板访问密码。**不要用弱口令**，网关首次启动会生成/让你设置一个。
        #   - 留空：面板需要你在 iframe 里手输一次密码；/workbuddy/realm 不可用。
        #   - 填了：进入面板自动登录；可用「切换区域」按钮（该操作必须用面板会话，
        #           API key 会被网关 403 拒绝）。
        # 密码只存在本文件里，插件不会把它写进日志。
        panelPassword: ''

        # 后台健康检查间隔（毫秒）；0 = 关闭，仅在被请求时探测。
        healthIntervalMs: 15000
