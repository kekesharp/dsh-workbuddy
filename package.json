{
  "name": "dsh-workbuddy",
  "version": "0.6.0",
  "description": "把 WorkBuddy / CodeBuddy 网关接进 DeepSeek Harness：插件自带网关（上游 v1.9.0），随 DSH 启动自动拉起、退出自动停止，并在 DSH 内提供状态图标与官方 Web 面板。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "assets",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "dsh-workbuddy contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kekesharp/dsh-workbuddy.git"
  },
  "homepage": "https://github.com/kekesharp/dsh-workbuddy#readme",
  "bugs": {
    "url": "https://github.com/kekesharp/dsh-workbuddy/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "workbuddy",
    "codebuddy",
    "workbuddy2api",
    "llm-provider",
    "gateway",
    "panel",
    "openai-compatible"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshTarget": "0.2.0-rc.2"
}
